# SQLite local por defecto (backend/riesgo_tributario.db).
# Para PostgreSQL, descomentar:
# DATABASE_URL=postgresql+psycopg2://usuario:clave@localhost:5432/riesgo_tributario
SECRET_KEY=cambiar-esto-en-produccion
TOKEN_MAX_AGE_SEG=28800
# Modelo servido: auto (el mejor del entrenamiento) | random_forest | xgboost | svm
MODELO_ACTIVO=auto
# Tarifa por hora del contador (S/) para el indicador C. DEFINIR Y SUSTENTAR en la tesis.
TARIFA_HORA_SOLES=35
